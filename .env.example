# =================================================================
# Private Telegram Download Bot Configuration
# =================================================================

# Telegram Bot Token from @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Strict Allowlist: Comma-separated list of EXACTLY TWO Telegram User IDs
# Example: ALLOWED_USERS=111111111,222222222
# You can find your Telegram ID using bots like @userinfobot
ALLOWED_USERS=111111111,222222222

# Maximum allowed file size in bytes (Standard Telegram Bot API limit is 50 MB = 52428800 bytes)
# Set higher (e.g. 2097152000 for 2GB) only if using a custom Local Telegram Bot API Server
MAX_FILE_SIZE=52428800

# Download Timeout in milliseconds (Default: 900000 ms = 15 minutes)
DOWNLOAD_TIMEOUT=900000

# Temporary directory for downloading and processing files
TEMP_DIRECTORY=./temp

# Custom path to yt-dlp binary (leave empty or omit to auto-detect from system PATH)
# Windows example: C:\Users\<Username>\AppData\Local\Programs\Python\Python314\Scripts\yt-dlp.exe
# Linux example: /usr/local/bin/yt-dlp
YTDLP_PATH=

# Custom path to ffmpeg binary (leave empty or omit to auto-detect from system PATH)
# Windows example: C:\ffmpeg\bin\ffmpeg.exe
# Linux example: /usr/bin/ffmpeg
FFMPEG_PATH=

# Logging level: trace, debug, info, warn, error, fatal (Default: info)
LOG_LEVEL=info

# Node environment: development or production
NODE_ENV=production

# Custom Telegram Bot API Server URL (optional, defaults to https://api.telegram.org)
# Use this if you run a local Telegram Bot API Server for up to 2GB file uploads
# TELEGRAM_API_ROOT=http://localhost:8081
