# ==============================================================================
# Rahami — رهامي
# Private Personal Media Downloader Environment Configuration
# ==============================================================================

# Application Environment (production | development | test)
ENVIRONMENT=production

# Cryptographic Secret Key (Generate a random string >= 32 characters)
# Example: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_a_random_32_character_secret_key_here_for_production

# ==============================================================================
# Strict Access Control: EXACTLY TWO AUTHORIZED USERS
# ==============================================================================
# Passwords must be hashed using bcrypt (never stored as plain text).
# Use the included CLI tool to generate password hashes:
#   python -m app.cli.hash_password <your_password>
#
# Format: username1:bcrypt_hash,username2:bcrypt_hash
ALLOWED_USERS=user1:$2b$12$...,user2:$2b$12$...

# Cookie Security (Set to True if running behind HTTPS / SSL)
COOKIE_SECURE=False

# ==============================================================================
# Supabase PostgreSQL & Storage Settings
# ==============================================================================
# Enter your Supabase project credentials (kept secret on the server-side only).
# The frontend NEVER receives the SERVICE_ROLE_KEY.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ==============================================================================
# Initial Administrator Credentials (Bootstrap)
# ==============================================================================
# Used only on first startup to initialize the admin account in the database.
# You can change your username and password anytime from the dashboard settings.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=RahamiAdmin2026!

# Download & Storage Limits
MAX_FILE_SIZE_MB=200
DOWNLOAD_TIMEOUT=900
MAX_CONCURRENT_DOWNLOADS=2
MAX_STORAGE_GB=10
MAX_DOWNLOAD_RETRIES=2
HEALTH_CHECK_INTERVAL=300
FILE_RETENTION_HOURS=24
