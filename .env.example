# ========================================================
# Rahami Telegram Bot - Environment Configuration Template
# ========================================================

# Telegram Bot Token from @BotFather
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Strictly exactly two authorized Telegram User IDs (comma-separated integers)
ALLOWED_USER_IDS=123456789,987654321

# Maximum download file size in Megabytes (Telegram bot limit is 50MB for standard bot API)
MAX_FILE_SIZE_MB=50

# Maximum download duration timeout in seconds (default 900 = 15 minutes)
DOWNLOAD_TIMEOUT=900

# Directory for isolated temporary task downloads
TEMP_DIR=./temp

# Maximum global concurrent downloads allowed simultaneously
MAX_CONCURRENT_DOWNLOADS=2

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
